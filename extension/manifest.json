{
  "manifest_version": 3,
  "name": "ANTRI RAMA",
  "short_name": "ANTRI RAMA",
  "version": "1.0.1",
  "description": "Asisten tanda tangan SRIKANDI: Setuju, Ambil Nomor, dan TTE hingga 10 naskah sekaligus dengan sekali Key Phrase. Bukan produk ANRI.",
  "author": "Deddy Eko Heryanto, S.T.",
  "key": "",
  "permissions": [
    "storage",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://srikandi.arsip.go.id/*",
    "https://api.arsip.go.id/*",
    "https://s3.arsip.go.id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://srikandi.arsip.go.id/*"
      ],
      "js": [
        "core.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ANTRI RAMA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}